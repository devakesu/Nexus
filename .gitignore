# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ==========================================
# 1. Python Core & Byte-compiled Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class

# ==========================================
# 2. Virtual Environments & Packages
# ==========================================
.venv/
venv/
ENV/
env/
# Pipenv / Poetry artifacts
.pipenv/
.poetry/
dist/
build/
*.egg-info/
.eggs/

# ==========================================
# 3. IDEs and Code Editors
# ==========================================
# Visual Studio Code
.vscode/
!.vscode/extensions.json
*.code-workspace

# PyCharm / IntelliJ
.idea/

# Jupyter Notebook checkpoints
.ipynb_checkpoints

# ==========================================
# 4. Environment Variables & Secrets (CRITICAL)
# ==========================================
.env
.env.local
.env.*
*.env
secrets.json
*.pem
*.key

# ==========================================
# 5. Testing, Linting, & Code Coverage
# ==========================================
.pytest_cache/
.tox/
.nox/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.black

# ==========================================
# 6. Database & Local Storage Caches
# ==========================================
*.db
*.sqlite3
instance/
.webassets-cache

# ==========================================
# 7. OS Generated / Temp Files
# ==========================================
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~
.fuse_hidden*
.directory

# ==========================================
# 8. Project Specific Overrides
# ==========================================
# Explicitly protect your hidden submodule pointer 
# (Git handles submodules natively, but this ensures loose logs aren't kept)
*.log
supabase/.temp/*
temp/
.infisical.json
.certificates/
app/api/dev_temp.py
.github/prompts
.github/skills
.agent*
.claude
.codebuddy
.codex
.continue
.cursor
.gemini
.kris
.mem
.aider
.aiderignore
.cursorignore
.trae
.opencode
.qoder
.roo
.windsurf
.kiro

# impeccable-ignore-start
# Ephemeral output, runtime state, and per-dev overrides.
# Unanchored: .impeccable may sit at the repo root or under a nested
# workspace (apps/web/.impeccable/...); anchored patterns would miss it.
# Shared artifacts stay tracked: config.json, live/config.json,
# design.json, critique/*.md.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/hook.pending.json
.impeccable/*.png
.impeccable/live/server.json
.impeccable/live/sessions/
.impeccable/live/previews/
.impeccable/live/annotations/
.impeccable/live/cache/
.impeccable/live/manual-edit-apply-transaction.json
.impeccable/live/manual-edit-events.jsonl
.impeccable/live/manual-edit-evidence/
.impeccable/live/pending-manual-edits.json
.impeccable/live/deferred-svelte-component-accepts.json
.impeccable/live/*.png
# impeccable-ignore-end

# ==========================================
# 9. Flutter & Mobile Monorepo Architecture
# ==========================================
# Flutter / Dart tooling artifacts
mobile/.dart_tool/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/.packages
mobile/.pub-cache/
mobile/.pub/
mobile/build/
mobile/pubspec.lock
mobile/*.iml
mobile/${workspaceFolder}*/
mobile/$*
mobile/scratch/

# Core Application Configuration & Secrets
mobile/lib/config/app_secrets.dart
mobile/**/google-services.json

# Android native tooling overrides
mobile/android/.gradle/
mobile/android/key.properties
mobile/.kotlin/
mobile/android/app/Flutter/Generated.xcconfig
mobile/android/app/src/main/res/values/strings.xml
mobile/android/app/src/main/res/raw/app_config.json
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/**/*.jks
mobile/android/**/*.keystore
mobile/android/**/*.p12

# iOS native tooling overrides
mobile/ios/.symlinks/
mobile/ios/Flutter/App.framework
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/.last_build_id
mobile/ios/Pods/
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/**/GoogleService-Info.plist
mobile/ios/DerivedData/
*.moved-aside
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3