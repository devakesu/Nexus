#!/bin/bash

# 1. Verify and enforce version constraints between branch name and pubspec.yaml
python3 scripts/sync-version.py --pre-commit
if [ $? -ne 0 ]; then
  echo "❌ Commit aborted: Version sync validation failed."
  exit 1
fi

# 2. Run mobile checks
echo "Checking and formatting staged Dart files..."

# Get staged dart files
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.dart$' || true)

if [ -n "$STAGED_DART_FILES" ]; then
  for file in $STAGED_DART_FILES; do
    if [ -f "$file" ]; then
      echo "Formatting $file..."
      dart format --output=write "$file"
      git add "$file"
    fi
  done
fi

# Run static analysis
cd mobile
flutter analyze
if [ $? -ne 0 ]; then
  echo "❌ Commit aborted: Flutter static analysis failed."
  exit 1
fi

exit 0
